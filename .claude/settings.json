{
  "env": {
    "AWS_SHARED_CREDENTIALS_FILE": "/dev/null",
    "AWS_CONFIG_FILE": "/dev/null"
  },
  "permissions": {
    "allow": [
      "Bash(make help)",
      "Bash(make build)",
      "Bash(make up)",
      "Bash(make down)",
      "Bash(make test *)",
      "Bash(make test-integration *)",
      "Bash(make lint)",
      "Bash(make fmt)",
      "Bash(make tf-check)",
      "Bash(make check)",
      "Bash(docker compose run --rm -T dev *)",
      "Bash(docker compose exec -T dev *)",
      "Bash(docker compose ps *)",
      "Bash(terraform fmt *)",
      "Bash(terraform validate *)",
      "Bash(terraform init -backend=false *)",
      "Bash(tflint *)",
      "Bash(checkov *)",
      "Bash(pytest *)",
      "Bash(python -m pytest *)",
      "Bash(ruff *)",
      "Bash(npm run lint *)",
      "Bash(npm run test *)",
      "Bash(npm run build *)"
    ],
    "deny": [
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(terraform apply *)",
      "Bash(terraform destroy *)",
      "Bash(aws *)",
      "Read(~/.aws/**)",
      "Edit(~/.aws/**)",
      "Read(devices/keys/**)",
      "Edit(devices/keys/**)",
      "Read(secrets/**)",
      "Edit(secrets/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/format.sh"
          }
        ]
      }
    ]
  }
}

# IoT device registry (docs/features/iot-core.md): thing types, one thing per device,
# static thing groups, one certificate per device registered from a committed CSR, and
# one least-privilege IoT policy per device type.
#
# Certificates are only ever created from a CSR, so AWS signs a public key and no
# private key is ever generated by AWS or stored in Terraform state. The private keys
# stay on the developer's machine (secrets/device-keys/, git-ignored).

data "aws_region" "current" {}
data "aws_caller_identity" "current" {}
data "aws_partition" "current" {}

locals {
  # Per device type: its static groups and the message types it may publish
  # (docs/metrics.md). One canary group per type because firmware is per type.
  device_types = {
    wearable = {
      description  = "Wrist-worn wearable: heart rate, SpO2, skin temperature, fall detection."
      group        = "wearables"
      canary_group = "canary-wearables"
      messages     = ["vitals", "fall", "status"]
    }
    bedroom = {
      description  = "Bedroom sensor: PIR motion sensor and bed pressure mat."
      group        = "bedroom-sensors"
      canary_group = "canary-bedroom-sensors"
      messages     = ["motion", "bed", "status"]
    }
  }

  thing_groups = merge(
    { for type, t in local.device_types : t.group => "Every ${type} device." },
    { for type, t in local.device_types : t.canary_group => "Canary ${type} devices: they get firmware updates first." },
  )

  # id => device. The variable validation rejects bad entries and names them; the
  # grouping (...) and the type filter only keep this expression from failing first
  # with a less helpful error.
  devices = {
    for id, ds in { for d in var.devices : d.id => d... } : id => ds[0]
    if contains(keys(local.device_types), ds[0].type)
  }

  # "<thing>/<group>" => membership. Every device is in its type group; canary devices
  # are also in their type's canary group.
  memberships = merge(
    {
      for id, d in local.devices : "${id}/${local.device_types[d.type].group}" => {
        thing = id
        group = local.device_types[d.type].group
      }
    },
    {
      for id, d in local.devices : "${id}/${local.device_types[d.type].canary_group}" => {
        thing = id
        group = local.device_types[d.type].canary_group
      } if d.canary
    },
  )

  arn_prefix = "arn:${data.aws_partition.current.partition}:iot:${data.aws_region.current.region}:${data.aws_caller_identity.current.account_id}"
}

resource "aws_iot_thing_type" "this" {
  for_each = local.device_types

  name = each.key

  properties {
    description = each.value.description
  }

  tags = var.tags
}

resource "aws_iot_thing" "device" {
  for_each = local.devices

  name            = each.key
  thing_type_name = aws_iot_thing_type.this[each.value.type].name
}

resource "aws_iot_thing_group" "this" {
  for_each = local.thing_groups

  name = each.key

  properties {
    description = each.value
  }

  tags = var.tags
}

resource "aws_iot_thing_group_membership" "device" {
  for_each = local.memberships

  thing_name       = aws_iot_thing.device[each.value.thing].name
  thing_group_name = aws_iot_thing_group.this[each.value.group].name
}

# Device policies use policy variables, so one policy per type serves every device of
# that type while each device can still only act as itself:
#  - connect only with client ID = its own thing name, and only with a certificate
#    attached to that thing
#  - publish only to its own topics, and only its type's message types
# No subscribe, receive, shadow, or wildcard actions (ota-updates adds the Jobs topics).
# $${...} escapes HCL interpolation, so the policy contains the literal ${...} variable.
data "aws_iam_policy_document" "device" {
  for_each = local.device_types

  statement {
    sid       = "ConnectAsOwnThing"
    effect    = "Allow"
    actions   = ["iot:Connect"]
    resources = ["${local.arn_prefix}:client/$${iot:Connection.Thing.ThingName}"]

    condition {
      test     = "Bool"
      variable = "iot:Connection.Thing.IsAttached"
      values   = ["true"]
    }
  }

  statement {
    sid     = "PublishOwnMessages"
    effect  = "Allow"
    actions = ["iot:Publish"]
    resources = [
      for m in each.value.messages : "${local.arn_prefix}:topic/silvercare/v1/$${iot:Connection.Thing.ThingName}/${m}"
    ]
  }
}

resource "aws_iot_policy" "device" {
  for_each = local.device_types

  name   = "silvercare-device-${each.key}"
  policy = data.aws_iam_policy_document.device[each.key].json

  tags = var.tags
}

# AWS signs the committed CSR. csr is immutable, so a new CSR (a replaced key) replaces
# the certificate and its attachments, which is expected.
resource "aws_iot_certificate" "device" {
  for_each = local.devices

  # file() on a missing path errors before the precondition runs, so guard it and let
  # the precondition fail the plan with a useful message. The placeholder is a string,
  # never null: without a CSR, AWS would generate the key and put it in state.
  csr    = fileexists("${var.csr_dir}/${each.key}.csr") ? file("${var.csr_dir}/${each.key}.csr") : "MISSING-CSR"
  active = true

  lifecycle {
    precondition {
      condition     = fileexists("${var.csr_dir}/${each.key}.csr")
      error_message = "Device ${each.key} has no CSR at ${var.csr_dir}/${each.key}.csr. Run `make device-keys` (or `make device-keys DEVICE=${each.key}`) and commit the CSR."
    }
  }
}

# EXCLUSIVE_THING: the certificate can be attached to this one thing only.
resource "aws_iot_thing_principal_attachment" "device" {
  for_each = local.devices

  thing                = aws_iot_thing.device[each.key].name
  principal            = aws_iot_certificate.device[each.key].arn
  thing_principal_type = "EXCLUSIVE_THING"
}

resource "aws_iot_policy_attachment" "device" {
  for_each = local.devices

  policy = aws_iot_policy.device[each.value.type].name
  target = aws_iot_certificate.device[each.key].arn
}

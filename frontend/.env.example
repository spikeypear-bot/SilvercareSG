# Copy to ../secrets/.env and fill in from `terraform output` (these values are not secrets).
VITE_USER_POOL_ID=ap-southeast-1_XXXXXXXXX
VITE_USER_POOL_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
# `terraform output -raw api_url`. The API's CORS allows http://localhost:5173 for `npm run dev`.
VITE_API_URL=https://xxxxxxxxxx.execute-api.ap-southeast-1.amazonaws.com
